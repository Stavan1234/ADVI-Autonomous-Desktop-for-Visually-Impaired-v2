# ADVI provider configuration
# Put real secrets only in .env. Never commit .env or credentials/.

# Configure at least one provider.
GROQ_API_KEY=
# Optional additional Groq keys for automatic key-level failover.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEYS=
# Optional quota grouping. One group per configured Groq key.
# Leave empty for independent key-level routing. If keys share one Groq project/quota,
# set the same group for those keys, e.g. groq-shared,groq-shared,groq-shared.
GROQ_KEY_GROUPS=

GEMINI_API_KEY=

# Optional additional Gemini keys for bounded failover.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEYS=
GEMINI_KEY_GROUPS=

# Model overrides (defaults are current production model IDs).
ADVI_GROQ_MODEL=openai/gpt-oss-120b
ADVI_GEMINI_MODEL=gemini-3.8-flash
ADVI_GEMINI_THINKING_LEVEL=low

# Optional Gmail paths. Default: credentials/gmail_credentials.json and
# credentials/gmail_token.json relative to the project root.
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=

# Optional bundled TTS path overrides.
ADVI_PIPER_EXE=
ADVI_PIPER_MODEL=
ADVI_TTS_OUTPUT=

# Environment/watchtower tuning.
ADVI_ENV_FULL_INVENTORY=0
ADVI_ENV_PROCESS_POLL_SECONDS=10

# Diagnostics. Call tracing is opt-in because it can capture user/task data.
ADVI_CALL_TRACE=0
ADVI_TERMINAL_TRACE=1
ADVI_CONSOLE_LOG_LEVEL=WARNING
