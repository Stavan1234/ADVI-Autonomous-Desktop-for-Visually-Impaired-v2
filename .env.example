# ADVI configuration template.
# Copy this file to .env (SETUP_ADVI.bat does it for you) and fill in your own values.
# Never commit .env or anything in credentials/.
#
# REQUIRED: at least one AI key (Groq or Gemini). Everything else is optional and
# has a working default; leave a line empty to use the default.

# ---------------------------------------------------------------------------
# AI providers (REQUIRED: at least one key)
# ---------------------------------------------------------------------------
# Groq (free key: https://console.groq.com/keys). The primary "brain" and the
# online speech recognition both use these keys.
GROQ_API_KEY=
# Optional extra Groq keys for automatic failover. They only add capacity when they
# come from different Groq accounts; keys of one account share one quota.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEYS=
# Optional quota grouping, one group per Groq key. If keys share one account/quota,
# give them the same group (e.g. shared,shared,shared) so a used-up quota isn't retried.
GROQ_KEY_GROUPS=

# Google Gemini (free key: https://aistudio.google.com/apikey). Backup brain when every
# Groq key is unavailable, and the screen-description ("vision") service.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEYS=
# By default all Gemini keys are treated as one quota group (gemini-default).
GEMINI_KEY_GROUPS=

# Model overrides (the defaults below are what ADVI was developed and tested with).
ADVI_GROQ_MODEL=openai/gpt-oss-120b
ADVI_GEMINI_MODEL=gemini-3.8-flash
ADVI_GEMINI_THINKING_LEVEL=low
# Gemini's experimental Interactions API. Off by default: on quota exhaustion it
# hung for 100+ seconds instead of failing fast.
ADVI_GEMINI_INTERACTIONS=0

# ---------------------------------------------------------------------------
# Voice (optional; on by default)
# ---------------------------------------------------------------------------
# ADVI listens all the time while it runs (no key needed). "Sleep" or "exit" closes
# ADVI; the hotkey interrupts its speech. While music or a video plays, only
# "ADVI, ..." sentences and plain media commands count.
# ADVI_VOICE=off disables the microphone and the hotkey.
ADVI_VOICE=on
# Echo cancellation (WebRTC, on this PC): ADVI removes its own voice from the
# microphone, so it never answers itself and you can talk over it to interrupt.
# off = the raw microphone (only for troubleshooting).
ADVI_ECHO_CANCEL=on
# Speech recognition is dual: Whisper large-v3-turbo on Groq when online, and a local
# Whisper model (no internet needed) otherwise. The local model is downloaded once,
# on first start, into assets/whisper (about 320 MB for distil-small.en).
# ADVI_STT_CLOUD=off keeps your audio on this computer (local recognition only).
ADVI_STT_CLOUD=on
ADVI_STT_CLOUD_MODEL=whisper-large-v3-turbo
# Local model. Measured on a 4-core laptop CPU: distil-small.en about 2-3 s per
# command; base.en about 1 s but mishears names more; large-v3-turbo 12+ s without a GPU.
ADVI_STT_MODEL=distil-small.en
ADVI_VOICE_LANGUAGE=en
# Leave empty to use the first free key of Ctrl+Alt+Space, Ctrl+Alt+Z, Ctrl+Alt+Enter
# (ADVI says which one at startup). Set it to use only that key, e.g. ctrl+alt+space.
ADVI_VOICE_HOTKEY=

# ---------------------------------------------------------------------------
# Wake word (optional; on by default)
# ---------------------------------------------------------------------------
# A small background listener starts ADVI when you say "wake up ADVI" (or "hey ADVI"),
# even when ADVI is closed. Setup registers it to start at every Windows sign-in.
# Recognition happens on this PC only. Remove it: .venv\Scripts\python.exe -m advi.wake uninstall
ADVI_WAKE=on
# Local model for the wake check (about 75 MB, ~0.4 s per phrase).
ADVI_WAKE_MODEL=tiny.en
# Optional, a dedicated keyword engine (Picovoice Porcupine, free for personal use):
# create an "ADVI" wake word for Windows at https://console.picovoice.ai/, put the .ppn
# file in assets\wake\, paste your AccessKey here, and run: pip install pvporcupine
PICOVOICE_ACCESS_KEY=
ADVI_WAKE_KEYWORD_FILE=
# Porcupine sensitivity 0-1: higher misses less but wakes by mistake more often.
ADVI_WAKE_SENSITIVITY=0.6

# ---------------------------------------------------------------------------
# Vision (optional; needs a Gemini key)
# ---------------------------------------------------------------------------
# Gemini describes a screenshot when you ask "what's on my screen", or when ADVI's
# structured tools can't see an app (at most 2 automatic looks per task).
ADVI_VISION=on
# Default gemini-3.1-flash-lite: its own free quota, so vision doesn't use up the
# brain's Gemini backup.
ADVI_VISION_MODEL=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Built-in commands (no AI needed) for simple requests such as "open youtube" or
# "pause". fallback (default) = only when every AI provider is unavailable;
# first = try them before the AI (saves quota); off = never.
ADVI_LOCAL_COMMANDS=fallback

# ---------------------------------------------------------------------------
# Paths and tools (optional; defaults are relative to the project folder)
# ---------------------------------------------------------------------------
# Gmail API OAuth client. Default: credentials/gmail_credentials.json and
# credentials/gmail_token.json. Without them Gmail works through the browser ("David").
GMAIL_CREDENTIALS_PATH=
GMAIL_TOKEN_PATH=
# Piper neural voice (see assets/README.md). Without it Windows' built-in voice is used.
ADVI_PIPER_EXE=
ADVI_PIPER_MODEL=
ADVI_TTS_OUTPUT=
# Tesseract OCR executable, if it isn't on PATH or in the usual install folders.
TESSERACT_CMD=
# MCP server configuration file (default: mcp_servers.json in the project folder).
ADVI_MCP_CONFIG=

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# Console log level; the full log is always written to logs/advi.log.
ADVI_CONSOLE_LOG_LEVEL=WARNING
# Environment watcher tuning.
ADVI_ENV_FULL_INVENTORY=0
ADVI_ENV_PROCESS_POLL_SECONDS=10
