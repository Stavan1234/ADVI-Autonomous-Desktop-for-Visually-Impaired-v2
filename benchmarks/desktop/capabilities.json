{
  "suite": "ADVI capability sweep",
  "version": 1,
  "notes": "A feature check of everything ADVI claims to do (2026-10-24), not a scored benchmark: tasks were written while fixing ADVI. Sends and deletes stop at the confirmation, which the runner always answers 'no'. Order matters: a 'close' task follows its 'open' task.",
  "tasks": [
    {"id": "cap-word-table", "domain": "word",
     "instruction": "Open Microsoft Word, create a new document named Months with a table of the twelve months of the year, and save it in Documents\\ADVI Bench\\cap-word-table.",
     "checks": [{"docx_table_rows": "Months.docx", "min_rows": 11}, {"docx_structure": "Months.docx", "min_tables": 1}]},
    {"id": "cap-word-report", "domain": "word",
     "instruction": "Write a Word document named Habits about healthy daily habits, with a title, two section headings and bullet points under each, and save it in Documents\\ADVI Bench\\cap-word-report.",
     "checks": [{"docx_structure": "Habits.docx", "min_headings": 3, "min_bullets": 4}]},
    {"id": "cap-word-two-col-table", "domain": "word",
     "instruction": "Create a Word document named Planets in Documents\\ADVI Bench\\cap-word-two-col-table with a table of the four inner planets and their distance from the Sun.",
     "checks": [{"docx_table_rows": "Planets.docx", "min_rows": 4}, {"docx_structure": "Planets.docx", "min_tables": 1}]},
    {"id": "cap-excel-create", "domain": "excel",
     "instruction": "Create an Excel spreadsheet named Budget in Documents\\ADVI Bench\\cap-excel-create with columns Item and Cost and these rows: Rent 9000, Food 4000, Travel 1500.",
     "checks": [{"xlsx_has": "Budget.xlsx", "values": ["Item", "Cost", "Rent", "9000", "Food", "4000", "Travel", "1500"]}]},
    {"id": "cap-excel-read", "domain": "excel",
     "instruction": "What is the total of the Cost column in Expenses.xlsx in Documents\\ADVI Bench\\cap-excel-read?",
     "setup": [{"xlsx": "Expenses.xlsx", "rows": [["Item", "Cost"], ["Rent", 9000], ["Food", 4000], ["Travel", 1500]]}],
     "checks": [{"answer_matches": "14,?500"}]},
    {"id": "cap-ppt-create", "domain": "powerpoint",
     "instruction": "Make a PowerPoint presentation named Solar with 3 slides about solar energy and save it in Documents\\ADVI Bench\\cap-ppt-create.",
     "checks": [{"pptx_has": "Solar.pptx", "min_slides": 3, "words": ["solar"]}]},
    {"id": "cap-pdf-create", "domain": "files",
     "instruction": "Create a PDF named Tips in Documents\\ADVI Bench\\cap-pdf-create with five tips for staying hydrated.",
     "checks": [{"pdf_has_text": "Tips.pdf", "words": ["water"]}]},
    {"id": "cap-read-docx", "domain": "files",
     "instruction": "Read Letter.docx in Documents\\ADVI Bench\\cap-read-docx and tell me who it is addressed to.",
     "setup": [{"docx": "Letter.docx", "text": "Dear Priya, the parcel will arrive on Monday. Regards, Stavan."}],
     "checks": [{"answer_matches": "Priya"}]},
    {"id": "cap-open-file", "domain": "files",
     "instruction": "Open notes.txt in Documents\\ADVI Bench\\cap-open-file.",
     "setup": [{"file": "notes.txt", "text": "ADVI capability sweep"}],
     "checks": [{"window_title_matches": "notes"}]},
    {"id": "cap-close-notepad", "domain": "apps",
     "instruction": "Close Notepad.",
     "checks": [{"answer_matches": "clos"}]},
    {"id": "cap-create-folders", "domain": "files",
     "instruction": "In Documents\\ADVI Bench\\cap-create-folders, create three folders named 2024, 2025 and Archive.",
     "checks": [{"is_dir": "2024"}, {"is_dir": "2025"}, {"is_dir": "Archive"}]},
    {"id": "cap-rename-folder", "domain": "files",
     "instruction": "Rename the folder Old to New in Documents\\ADVI Bench\\cap-rename-folder.",
     "setup": [{"dir": "Old"}, {"file": "Old/keep.txt", "text": "keep"}],
     "checks": [{"exists": "New/keep.txt"}, {"missing": "Old"}]},
    {"id": "cap-copy-folder", "domain": "files",
     "instruction": "Copy the Photos folder into a folder named Backup, both in Documents\\ADVI Bench\\cap-copy-folder.",
     "setup": [{"png": "Photos/a.png"}, {"png": "Photos/b.png"}],
     "checks": [{"exists": "Backup/Photos/a.png"}, {"exists": "Photos/a.png"}]},
    {"id": "cap-delete-file", "domain": "files",
     "instruction": "Delete temp.txt from Documents\\ADVI Bench\\cap-delete-file.",
     "setup": [{"file": "temp.txt", "text": "remove me"}, {"file": "keep.txt", "text": "keep"}],
     "checks": [{"missing": "temp.txt"}, {"exists": "keep.txt"}]},
    {"id": "cap-search-content", "domain": "files",
     "instruction": "Which file in Documents\\ADVI Bench\\cap-search-content mentions an invoice?",
     "setup": [{"file": "bills.txt", "text": "Invoice 7731 from the electricity board."}, {"file": "poem.txt", "text": "Roses are red."}, {"file": "todo.txt", "text": "Buy milk."}],
     "checks": [{"answer_matches": "bills"}]},
    {"id": "cap-count-pdfs", "domain": "files",
     "instruction": "How many PDF files are in Documents\\ADVI Bench\\cap-count-pdfs?",
     "setup": [{"pdf": "a.pdf"}, {"pdf": "b.pdf"}, {"pdf": "c.pdf"}, {"file": "d.txt", "text": "x"}],
     "checks": [{"answer_matches": "\\b(?:3|three)\\b"}]},
    {"id": "cap-largest-file", "domain": "files",
     "instruction": "Which is the largest file in Documents\\ADVI Bench\\cap-largest-file?",
     "setup": [{"sized": "small.bin", "bytes": 1000}, {"sized": "huge.bin", "bytes": 5000000}, {"sized": "medium.bin", "bytes": 200000}],
     "checks": [{"answer_matches": "huge"}]},
    {"id": "cap-recommend", "domain": "files",
     "instruction": "I want to revise for my chemistry exam. Which file in Documents\\ADVI Bench\\cap-recommend should I open?",
     "setup": [{"docx": "chemistry_exam_notes.docx", "text": "Periodic table, bonding, acids and bases."}, {"file": "pasta_recipe.txt", "text": "Boil water, add pasta."}, {"pdf": "electricity_bill.pdf"}],
     "checks": [{"answer_matches": "chemistry_exam_notes"}]},
    {"id": "cap-organize", "domain": "files",
     "instruction": "Organize the files in Documents\\ADVI Bench\\cap-organize by type.",
     "setup": [{"pdf": "report.pdf"}, {"png": "photo.png"}, {"file": "notes.txt", "text": "x"}, {"docx": "letter.docx", "text": "x"}],
     "checks": [{"none_at_top": ["report.pdf", "photo.png", "notes.txt", "letter.docx"]}, {"exists_somewhere": ["report.pdf", "photo.png", "notes.txt", "letter.docx"]}]},
    {"id": "cap-play-video", "domain": "media",
     "instruction": "Play the video clip.mp4 in Documents\\ADVI Bench\\cap-play-video.",
     "setup": [{"copy_from": "Videos", "pattern": "*.mp4", "as": "clip.mp4"}],
     "checks": [{"process_running": ["Microsoft.Media.Player.exe", "Video.UI.exe", "vlc.exe", "wmplayer.exe", "mpc-hc64.exe", "PotPlayerMini64.exe"]}]},
    {"id": "cap-close-video", "domain": "media",
     "instruction": "Close the video player.",
     "checks": [{"process_not_running": ["Microsoft.Media.Player.exe", "Video.UI.exe", "vlc.exe", "wmplayer.exe"]}]},
    {"id": "cap-play-audio", "domain": "media",
     "instruction": "Play the audio file tone.wav in Documents\\ADVI Bench\\cap-play-audio.",
     "setup": [{"wav": "tone.wav", "seconds": 20}],
     "checks": [{"process_running": ["Microsoft.Media.Player.exe", "Music.UI.exe", "vlc.exe", "wmplayer.exe", "Groove.exe"]}]},
    {"id": "cap-close-audio", "domain": "media",
     "instruction": "Close the music player.",
     "checks": [{"process_not_running": ["Microsoft.Media.Player.exe", "Music.UI.exe", "wmplayer.exe", "Groove.exe"]}]},
    {"id": "cap-youtube", "domain": "browser",
     "instruction": "Play Believer by Imagine Dragons on YouTube.",
     "checks": [{"browser_url_matches": "youtube\\.com/watch"}]},
    {"id": "cap-youtube-pause", "domain": "browser",
     "instruction": "Pause the video.",
     "checks": [{"answer_matches": "paus"}]},
    {"id": "cap-web-google", "domain": "browser",
     "instruction": "Search Google for the weather in Mumbai.",
     "checks": [{"browser_url_matches": "google\\.[a-z.]+/search.*weather"}]},
    {"id": "cap-web-amazon", "domain": "browser",
     "instruction": "Search Amazon for a wireless mouse.",
     "checks": [{"browser_url_matches": "amazon\\.[a-z.]+/s\\?.*(?:wireless|mouse)"}]},
    {"id": "cap-web-flipkart", "domain": "browser",
     "instruction": "Search Flipkart for running shoes.",
     "checks": [{"browser_url_matches": "flipkart\\.com/search.*(?:running|shoes)"}]},
    {"id": "cap-web-github", "domain": "browser",
     "instruction": "Go to GitHub and search for python voice assistant.",
     "checks": [{"browser_url_matches": "github\\.com/search.*voice"}]},
    {"id": "cap-web-answer", "domain": "browser",
     "instruction": "According to Wikipedia, what is the capital of Australia?",
     "checks": [{"answer_matches": "canberra"}]},
    {"id": "cap-email-inbox", "domain": "email",
     "instruction": "Check my inbox and tell me who sent the latest email and what its subject is.",
     "checks": [{"answer_matches": "(?:from|sent by|subject)"}, {"no_tool": ["email_send", "email_trash", "email_forward"]}]},
    {"id": "cap-email-unread", "domain": "email",
     "instruction": "How many unread emails do I have?",
     "checks": [{"answer_matches": "\\d|no unread|none"}, {"no_tool": ["email_send", "email_trash"]}]},
    {"id": "cap-email-send-confirm", "domain": "email",
     "instruction": "Send an email to advi.test@example.com with the subject ADVI check saying this is an ADVI capability test.",
     "checks": [{"confirmation_matches": ["advi.test@example.com", "capability test"]}, {"no_tool": ["email_send"]}]},
    {"id": "cap-email-trash-confirm", "domain": "email",
     "instruction": "Delete the latest email in my inbox.",
     "checks": [{"confirmation_matches": ["trash"]}, {"no_tool": ["email_trash"]}]},
    {"id": "cap-time", "domain": "system",
     "instruction": "What time is it?",
     "checks": [{"answer_matches": "\\d{1,2}[:.]\\d{2}"}]},
    {"id": "cap-disk", "domain": "system",
     "instruction": "How much free disk space do I have?",
     "checks": [{"answer_matches": "\\d+(?:\\.\\d+)?\\s*(?:GB|gigabytes|TB)"}]},
    {"id": "cap-open-calculator", "domain": "apps",
     "instruction": "Open Calculator.",
     "checks": [{"process_running": ["CalculatorApp.exe", "Calculator.exe", "calc.exe"]}]},
    {"id": "cap-close-calculator", "domain": "apps",
     "instruction": "Close Calculator.",
     "checks": [{"process_not_running": ["CalculatorApp.exe", "Calculator.exe"]}]}
  ]
}
